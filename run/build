#!/bin/sh

# Build the CV to dist/kieran-potts-cv.pdf. Run ./run/install first.

set -eu

# All the paths below are relative to the project root, so run from there, wherever the script was
# invoked from.
cd "$(dirname "$0")/.."

mkdir -p dist

# The latest Git tag is injected as \cvVersion, to be printed in the CV footer. Falls back to empty
# if there are no tags.
#
VERSION=$(git describe --tags --abbrev=0 2>/dev/null || true)

# Run `pdflatex` under the TinyTeX pinned in mise.toml, via `mise exec`. This is the same on the
# host, in the devcontainer, and in CI, whether or not mise is activated in the calling shell. The
# `-output-directory` option specifies the output directory for the PDF files generated by this
# program. `src/kieran-potts-cv.tex` is the input LaTeX file that will be compiled into a PDF.
#
# `-interaction=nonstopmode` and `-halt-on-error` stop at the first error, rather than waiting for
# input, so the build works with no terminal attached too, eg. in CI or under a coding agent.
#
exec mise exec -- pdflatex \
  -interaction=nonstopmode \
  -halt-on-error \
  -jobname=kieran-potts-cv \
  -output-directory dist \
  "\\def\\cvVersion{${VERSION}}\\input{src/kieran-potts-cv.tex}"
