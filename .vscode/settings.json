{

  /* Vertical guidelines for line wrapping. */
  "editor.rulers": [
    80,
    100,
    120,
  ],

  /* By default, wrap long lines at the viewport or 120 characters,
  whichever is narrowest. */
  "editor.wordWrap": "bounded",
  "editor.wordWrapColumn": 120,

  "[markdown]": {
    /* Wrap Markdown files at 72 characters. */
    "editor.wordWrap": "bounded",
    "editor.wordWrapColumn": 72,

    /* Enable auto-formatting for Markdown files. */
    "editor.formatOnPaste": true,
    "editor.formatOnSave": true,
    "editor.formatOnType": true,

    /* Enable auto-fixes for Markdown files. */
    "editor.codeActionsOnSave": {
      "source.fixAll": "always",
    },
  },

  /* Spell check language for this repository differs from the
  workspace default – en-US. */
  "cSpell.language": "en-GB",

  /* Add custom dictionary for this repository only. */
  "cSpell.customDictionaries": {
    "personalDictionary": {
      "name": "Personal Dictionary (en-GB)",
      "path": "${workspaceFolder:kieranpotts/dictionary}/src/en-GB.txt",
      "scope": "workspace",
      "addWords": true
    }
  },

}
